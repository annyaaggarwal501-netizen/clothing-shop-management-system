      "name": "Login as owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/auth/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Postman keeps the session cookie for the next calls.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"owner\",\n  \"password\": \"Owner@123\"\n}"
        }
      }
    },
